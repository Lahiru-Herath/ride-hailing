# Copy to .env (cp .env.example .env). Development defaults only - no real secrets.

# Simulated clock: 1 simulated day = 300 real seconds (D6)
SIM_DAY_DURATION_SECONDS=300
STREAM_EVENT_INTERVAL_SECONDS=3

# Kafka (host-side scripts connect through the PLAINTEXT_HOST listener)
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC_TRIP_EVENTS=trip_events

# Postgres (host port 5433 -> container 5432, D11)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ridehailing
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline

# SQLAlchemy / Alembic
DATABASE_URL=postgresql+psycopg2://pipeline:pipeline@localhost:5433/ridehailing

# Fleet
NUM_VEHICLES=15
IDLE_ALERT_THRESHOLD_MINUTES=10

# Batch layer
BATCH_OUTPUT_DIR=storage/batch_incoming
